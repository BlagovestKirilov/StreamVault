    {
      "type": "timeseries",
      "title": "Memory",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
