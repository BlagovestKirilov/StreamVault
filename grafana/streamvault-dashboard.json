          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(streamvault_memory_threshold_bytes{level=\"warn\"})",
          "legendFormat": "watchdog: evict half M3U cache",
