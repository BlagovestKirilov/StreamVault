        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(streamvault_memory_threshold_bytes{level=\"crit\"})",
          "legendFormat": "watchdog: clear all caches",
          "refId": "E"
